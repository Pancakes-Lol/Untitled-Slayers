{
  "name": "Untitled Slayers",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "GameServer": {
        "$path": "src/server"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "GameShared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Configs": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,
          "EnemyConfig": {
            "$path": "src/configs/EnemyConfig.luau"
          },
          "QuestConfig": {
            "$path": "src/configs/QuestConfig.luau"
          },
          "SwordsConfig": {
            "$path": "src/configs/SwordsConfig.luau"
          },
          "StatConfig": {
            "$path": "src/configs/StatConfig.luau"
          }
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "GameClient": {
          "$path": "src/client"
        }
      }
    }
  }
}
