    {
      "properties": {
        "Enabled": true,
        "Archivable": true,
        "Name": "CoinsLabel"
      },
      "path": "StarterGui/MainUI/MainFrame/CashLabel/CoinsLabel",
      "source": "-- CoinsLabel (LocalScript) > TextLabel\nlocal Players = game:GetService(\"Players\")\n\nlocal player      = Players.LocalPlayer\nlocal coinsLabel  = script.Parent\n\n-- ─── Format number with commas ────────────────────────────────────────────────\n\nlocal function formatCoins(n)\n\tlocal str     = tostring(math.floor(n))\n\tlocal result  = \"\"\n\tlocal count   = 0\n\n\tfor i = #str, 1, -1 do\n\t\tif count > 0 and count % 3 == 0 then\n\t\t\tresult = \",\" .. result\n\t\tend\n\t\tresult = str:sub(i, i) .. result\n\t\tcount += 1\n\tend\n\n\treturn result .. \"$\"\nend\n\n-- ─── Update label ─────────────────────────────────────────────────────────────\n\nlocal function updateLabel(coins)\n\tcoinsLabel.Text = formatCoins(coins)\nend\n\n-- ─── Hook into leaderstats ────────────────────────────────────────────────────\n\nlocal function setupCoins()\n\tlocal leaderstats = player:WaitForChild(\"leaderstats\")\n\tlocal coins       = leaderstats:WaitForChild(\"Coins\")\n\n\tupdateLabel(coins.Value)\n\n\tcoins:GetPropertyChangedSignal(\"Value\"):Connect(function()\n\t\tupdateLabel(coins.Value)\n\tend)\nend\n\nsetupCoins()",
      "class": "LocalScript"
    },
